# GEMINI_API_KEY: Required for server-side Gemini AI Security Copilot calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional External Integration Endpoints (Configured via Integrations UI or Env)
MISP_BASE_URL=""
MISP_API_KEY_REF=""
SIEM_WEBHOOK_URL=""
SCANNER_PROVIDER_MODE="SIMULATED_SAFE"
BARON_STORAGE_PATH="./data/baron-nexus-db.json"

